# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Nested vault from in-repo installer runs
# If someone runs setup.ps1/setup.sh inside the repo itself, it creates a
# VaultBot/ subfolder â€” never commit that.
# Anchored to root so it doesn't match .obsidian/plugins/vaultbot/.
# NOTE: removed the bare `/VaultBot/` rule — on case-insensitive filesystems
# (Windows, core.ignorecase=true) it silently matched the `vaultbot/` SOURCE
# folder and ignored every new source file. The nested-installer scenario is
# an edge case not worth silently dropping source code.

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
