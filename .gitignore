# ─────────────────────────────────────────────────────────────────────
# Secrets & personal config
# NEVER commit - API keys, owner name, local paths.
# ─────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─────────────────────────────────────────────────────────────────────
# Python virtual environment
# Users create their own: python -m venv vaultbot_venv  (or .venv)
# ─────────────────────────────────────────────────────────────────────
vaultbot_venv/
.venv/
venv/
env/

# ─────────────────────────────────────────────────────────────────────
# Python cache
# ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg

# ─────────────────────────────────────────────────────────────────────
# VaultBot runtime state (regenerated on first run)
# These are YOUR vault's state - another user's VaultBot makes its own.
# ─────────────────────────────────────────────────────────────────────
vaultbot_backend/identity/
vaultbot_backend/sessions/
vaultbot_backend/checkpoints/
vaultbot_backend/vaultbot_index/
vaultbot_backend/vaultbot/
vaultbot_backend/vaultbot.pid
vaultbot_backend/curriculum_state.json
vaultbot_backend/touch_counts.json
vaultbot_backend/embedding_drift.json
vaultbot_backend/conversation_state.json
vaultbot_backend/conversation_state.*
vaultbot_backend/procedure_failure_log.json
vaultbot_backend/calibration_log.json
vaultbot_backend/claim_verification_log.json
vaultbot_backend/consolidation_log.json
vaultbot_backend/rag_eval_log.json
vaultbot_backend/backend.log
vaultbot_backend/backend.err
vaultbot_backend/backend_stdout.log
vaultbot_backend/backend_stderr.log
vaultbot_backend/pythonw_stdout.log
vaultbot_backend/pythonw_stderr.log
vaultbot_backend/boot.log
vaultbot_backend/maintenance.log
vaultbot_backend/test_err.log
vaultbot_backend/test_out.log
vaultbot_backend/*.bak
vaultbot_backend/*.bak.*
vaultbot_backend/custom_tools/*.bak
vaultbot_backend/speech.py.vosk_bak
vaultbot_backend/_test_*.py
vaultbot_backend/trash/
vaultbot_backend/partials/
vaultbot_backend/*_log.json

# ─────────────────────────────────────────────────────────────────────
# Large model files (downloaded separately, see README)
