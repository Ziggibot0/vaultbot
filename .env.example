# ─── VaultBot configuration ─────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values. See the README for setup.

# ─── Vault path ────────────────────────────────────────────────────────────
# The absolute path to your Obsidian vault (this repo's root by default).
VAULT_PATH=.

# ─── Owner identity ────────────────────────────────────────────────────────
# Your name. VaultBot addresses you by this and treats you as its operator.
# Leave blank to have VaultBot call you "the user" until it learns your name.
VAULTBOT_OWNER=

# ─── Ollama (embeddings always; LLM optional) ───────────────────────────────
# Ollama runs locally. The setup script auto-pulls ONLY the lightweight
# embedding model (nomic-embed-text, ~270 MB). The chat/synthesis LLM is
# NOT auto-pulled — large LLMs (5-20+ GB) can overwhelm a laptop.
#
# Two ways to provide the chat LLM:
#   1. Cloud API (RECOMMENDED for laptops): set LLM_BACKEND=openai below
#      + LLM_API_KEY + LLM_MODEL. Zero local compute, works on any laptop.
#   2. Local Ollama: manually run `ollama pull qwen3:latest` (or any model)
#      and set LLM_BACKEND=ollama. Free + private, but needs the disk/RAM.
#
# Embeddings ALWAYS use Ollama + nomic-embed-text (light, ~270 MB).
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3.6:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Chat / synthesis LLM backend ──────────────────────────────────────────
# LLM_BACKEND=openai  -> use any OpenAI-compatible cloud API (recommended for
#   laptops: zero local compute). Set LLM_API_KEY + LLM_MODEL + LLM_BASE_URL.
#   Examples: OpenAI (gpt-4o-mini), OpenRouter (any model), vLLM, LM Studio.
# LLM_BACKEND=ollama   -> use local Ollama for chat (requires manual
#   `ollama pull <model>` — the setup script does NOT auto-pull chat models).
LLM_BACKEND=openai
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ─── Research backend ──────────────────────────────────────────────────────
# "freesearch" (default, keyless: DuckDuckGo + Marginalia + arXiv) or
# "tavily" (API-key'd, no rate-limiting, returns content inline).
VAULTBOT_RESEARCH_BACKEND=freesearch
TAVILY_API_KEY=

# ─── SearXNG (optional self-hosted search, needs Docker) ───────────────────
# If you run the bundled SearXNG container, it joins the FreeSearch pool
# for mainstream-web coverage. Leave default if you don't use Docker.
SEARXNG_PORT=8080